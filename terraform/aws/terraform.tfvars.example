# Preferred: leave aws_access_key / aws_secret_key unset here and export
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# or use ~/.aws/credentials / an SSO profile. tfvars ends up in state, env
# vars do not.
# aws_access_key = "your-aws-access-key-id"
# aws_secret_key = "your-aws-secret-access-key"

region         = "us-east-1"      # see: https://docs.aws.amazon.com/general/latest/gr/rande.html
instance_type  = "t3.medium"      # 2 vCPU, 4 GB
ssh_public_key = "ssh-ed25519 AAAA... your-key-comment"
ssh_allowed_ipv4 = "0.0.0.0/0"    # lock to your IP for production: "X.X.X.X/32"
repo_url       = "https://github.com/cycle-five/lavalink-ops.git"
admin_port     = 8080             # Not exposed publicly; reached via SSH tunnel
